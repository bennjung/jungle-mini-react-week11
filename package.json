{
  "name": "mini-react",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.phase2.config.ts --open /phase2-cat.html",
    "dev:phase1": "vite --open /main.html",
    "dev:counter": "vite --config vite.phase2.config.ts --open /phase2.html",
    "dev:events": "vite --config vite.phase2.config.ts --open /demos/events.html",
    "dev:hooks": "vite --config vite.phase2.config.ts --open /demos/hooks.html",
    "dev:input": "vite --config vite.phase2.config.ts --open /demos/input.html",
    "dev:select": "vite --config vite.phase2.config.ts --open /demos/select.html",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
